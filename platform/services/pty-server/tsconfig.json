{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@contracts/*": ["../../packages/contracts/*"],
      "@contracts": ["../../packages/contracts"],
      "@shared/*": ["../../packages/shared/*"],
      "@shared": ["../../packages/shared"]
    }
  },
  "include": ["src/**/*"]
}
